{
  "id": "patchnest-diagnostic-hello",
  "name": "PatchNest Diagnostic Hello",
  "version": "0.1.0",
  "author": "PatchNest Maintainers",
  "license": "GPL-2.0-or-later",
  "description": "Non-invasive KPM used to validate build, load, control, unload, and provenance pipelines.",
  "source": "modules/diagnostic-hello/diagnostic_hello.c",
  "artifact": "patchnest-diagnostic-hello.kpm",
  "upstreamSdk": {
    "repository": "KernelSU-Next/KPatch-Next",
    "commit": "0fe6d142266b80e5aa445a7ea1534f88a8f33a35",
    "linkerScript": {
      "path": "kpms/demo-hello/hello.lds",
      "gitBlobSha": "d599a67aabae7920d30845019e74b01a58d684b4"
    }
  },
  "build": {
    "sources": [
      "modules/diagnostic-hello/diagnostic_hello.c"
    ],
    "localHeaders": [],
    "linkerScript": "modules/diagnostic-hello/diagnostic_hello.lds",
    "linkerSentinelSections": [
      ".plt",
      ".init.plt",
      ".text.ftrace_trampoline"
    ],
    "declaredInputs": [
      "modules/diagnostic-hello/Makefile",
      "modules/diagnostic-hello/README.md",
      "modules/diagnostic-hello/diagnostic_hello.c",
      "modules/diagnostic-hello/diagnostic_hello.lds",
      "modules/diagnostic-hello/module.json"
    ],
    "generatedOutputs": [
      "modules/diagnostic-hello/diagnostic_hello.d",
      "modules/diagnostic-hello/diagnostic_hello.o",
      "modules/diagnostic-hello/patchnest-diagnostic-hello.kpm",
      "modules/diagnostic-hello/patchnest-diagnostic-hello.map"
    ],
    "allowedUndefinedSymbols": [
      "compat_copy_to_user",
      "kpver",
      "printk"
    ]
  },
  "channel": "build-only",
  "installable": false,
  "capabilities": [
    "kernel-log lifecycle messages",
    "constant diagnostic control response"
  ],
  "prohibitedCapabilities": [
    "hooking",
    "hiding",
    "policy modification",
    "boot-state modification",
    "persistence"
  ],
  "releaseGate": "Physical-device lifecycle validation required before catalog publication."
}
